# Telegram bot tokeni (@BotFather orqali olinadi)
BOT_TOKEN=

# Admin Telegram chat ID'lari, vergul bilan ajratilgan
# Masalan: 123456789,987654321
ADMIN_CHAT_IDS=

# Google Service Account kaliti (JSON) joylashgan fayl yo'li
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./credentials.json

# Google Sheets jadval ID'si (jadval URL'idagi /d/<BU_YER>/edit qismi)
GOOGLE_SHEET_ID=

# Google Drive papka ID'si (CV fayllar shu papkaga yuklanadi)
GOOGLE_DRIVE_FOLDER_ID=

# Ixtiyoriy: Google Workspace domenida domain-wide delegation ishlatilsa,
# service account shu foydalanuvchi nomidan ishlaydi (fayllarga egalik/kvota uchun)
GOOGLE_IMPERSONATE_EMAIL=

# SMTP sozlamalari (email bildirishnoma uchun)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=OAbdujalilov@nbu.uz
